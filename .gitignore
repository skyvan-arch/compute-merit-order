# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# Environment / secrets
.env
.env.*
*.token

# Interim is LOCAL WORKING DATA and must never be published: it holds the
# full un-gated series including bidding zones whose upstream licence forbids
# redistribution. Only /data/final is published, and only after the licence
# gate in pipelines/power_price.py has run.
/data/interim/**
!/data/interim/.gitkeep

# Data cache — keep manifests, ignore raw API payloads.
# Note the `/**` rather than `/*`: `/*` only matches direct children, so
# nested per-source payloads (data/raw/<source>/*.json) escaped the ignore.
/data/raw/**
!/data/raw/**/
!/data/raw/**/MANIFEST.md
!/data/raw/.gitkeep

# LaTeX build artefacts
/paper/*.aux
/paper/*.bbl
/paper/*.bcf
/paper/*.blg
/paper/*.fdb_latexmk
/paper/*.fls
/paper/*.log
/paper/*.out
/paper/*.run.xml
/paper/*.synctex.gz
/paper/*.toc
# Compiled PDF is a CI build artefact, not hand-committed
/paper/main.pdf

# OS
.DS_Store
Thumbs.db
